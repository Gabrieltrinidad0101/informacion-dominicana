FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    ffmpeg \
    wget \
    && rm -rf /var/lib/apt/lists/*


COPY pii/requirements.txt ./pii/requirements.txt
RUN pip install --no-cache-dir -r pii/requirements.txt

COPY shared ./shared
COPY pii ./pii

ENTRYPOINT ["python3", "-u", "pii/main.py"]
